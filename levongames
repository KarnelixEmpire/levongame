<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Levon Games</title>
<meta name="description" content="Levon Games: bot Mạt chược Riichi cho Discord và các trò chơi nhóm vui cùng bạn bè.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;700&family=Be+Vietnam+Pro:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@700&display=swap" rel="stylesheet">
<style>
:root{
  --felt:#0d3b31; --felt-deep:#082a23; --felt-light:#16523f;
  --ivory:#f4ecd8; --ink:#1d1a14; --red:#c8372d; --gold:#e0b45a;
  --discord:#5865f2; --discord-deep:#3a45b3;
  --text:#ece6d2; --muted:#a6c4b7; --line:rgba(244,236,216,.16);
  --display:'Fraunces',Georgia,'Times New Roman',serif;
  --body:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',sans-serif;
  --han:'Noto Serif TC','Songti TC','SimSun',serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--felt-deep);color:var(--text);line-height:1.65;min-height:100vh;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}
button,select,textarea,input{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:6px}
.i{width:1.15em;height:1.15em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.i.fill{fill:currentColor;stroke:none}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
.page{padding:72px 0 96px;min-height:70vh}
section{padding:96px 0}
#app,footer,.topbar{position:relative;z-index:1}
.sprite{position:absolute;width:0;height:0;overflow:hidden}

/* ---------- Thanh điều hướng ---------- */
.topbar{position:sticky;top:0;z-index:50;background:rgba(8,42,35,.8);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.topbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;height:68px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none;font-family:var(--display);font-weight:700;font-size:1.25rem;letter-spacing:-.01em}
.logo-tile{width:28px;height:38px;border-radius:5px;background:var(--ivory);color:var(--red);font:700 1.1rem/38px var(--han);text-align:center;box-shadow:0 3px 0 #2c8a68}
.nav-links{display:flex;align-items:center;gap:6px}
.nav-links a{display:inline-flex;align-items:center;gap:8px;text-decoration:none;font-weight:500;font-size:.95rem;color:var(--muted);padding:8px 14px;border-radius:10px;transition:color .2s,background .2s}
.nav-links a:hover,.nav-links a.active{color:var(--ivory);background:rgba(244,236,216,.07)}
.nav-links a.active{color:var(--gold)}
.nav-links .nav-cta{background:var(--discord);color:#fff;font-weight:600}
.nav-links .nav-cta:hover{background:#6b77f5;color:#fff}

/* ---------- Nút ---------- */
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:12px;font:600 1rem var(--body);text-decoration:none;border:0;cursor:pointer;transition:transform .2s,background .2s,border-color .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(1px)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.btn-discord{background:var(--discord);color:#fff;box-shadow:0 6px 0 var(--discord-deep)}
.btn-discord:hover{background:#6b77f5}
.btn-ghost{border:1.5px solid rgba(244,236,216,.4);color:var(--ivory);background:none}
.btn-ghost:hover{border-color:var(--ivory);background:rgba(244,236,216,.07)}
.btn-gold{background:var(--gold);color:var(--ink);box-shadow:0 6px 0 #a57f33}
.btn-gold:hover{background:#eac271}
.btn-red{background:var(--red);color:#fff8ea;box-shadow:0 6px 0 #8f2119}
.btn-red:hover{background:#d4402f}
.btn-sm{padding:10px 18px;font-size:.92rem}

/* ---------- Trang chủ ---------- */
.hero{background:radial-gradient(ellipse 80% 70% at 70% 40%,var(--felt-light) 0%,var(--felt) 45%,var(--felt-deep) 100%);padding:96px 0 88px}
.hero .wrap{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:center}
h1{font-family:var(--display);font-weight:700;font-size:clamp(2.4rem,5vw,4.2rem);line-height:1.06;letter-spacing:-.025em;color:var(--ivory);margin-bottom:24px}
h2{font-family:var(--display);font-weight:700;font-size:clamp(1.8rem,3.4vw,2.6rem);line-height:1.15;letter-spacing:-.02em;color:var(--ivory)}
h3{font-family:var(--display);font-weight:700;color:var(--ivory)}
.lead{font-size:1.12rem;color:var(--muted);max-width:34em;margin-bottom:36px}
.actions{display:flex;flex-wrap:wrap;gap:14px}
.table{display:flex;flex-direction:column;gap:30px;align-items:center}
.hand,.river{display:flex;justify-content:center;flex-wrap:wrap}
.hand{--w:clamp(40px,6.4vw,66px);gap:calc(var(--w)*.08);padding-top:20px}
.river{--w:clamp(28px,4.2vw,42px);gap:calc(var(--w)*.1);min-height:calc(var(--w)*1.4 + 14px);width:100%;padding:14px;border:1.5px dashed var(--line);border-radius:14px;align-content:center}
.river:empty::before{content:"Quân đã đánh sẽ nằm ở đây";color:var(--muted);font-size:.9rem}
.tile{width:var(--w);aspect-ratio:5/7;font-size:calc(var(--w)*.54);border:0;border-radius:calc(var(--w)*.14);background:linear-gradient(160deg,#fffaf0,var(--ivory));color:var(--ink);font-family:var(--han);font-weight:700;display:grid;place-items:center;position:relative;cursor:pointer;
  box-shadow:0 calc(var(--w)*.12) 0 #2c8a68,0 calc(var(--w)*.22) calc(var(--w)*.3) rgba(0,0,0,.45);transform:rotate(var(--r,0deg));transition:transform .2s ease}
.hand .tile:hover{transform:translateY(-14px) rotate(0deg)}
.tile.red{color:var(--red)} .tile.green{color:#1b7a50}
.tile.blank::after{content:"";position:absolute;inset:18%;border:2px solid #2a5ea8;border-radius:3px}
.hint{font-size:.9rem;color:var(--muted)}
.sec-head{max-width:36em;margin-bottom:48px}
.sec-head p{color:var(--muted);margin-top:14px}
.feature{display:grid;grid-template-columns:56px 1fr auto;gap:28px;align-items:center;padding:32px 0;border-top:1px solid var(--line)}
.feature:last-child{border-bottom:1px solid var(--line)}
.f-icon{width:56px;height:56px;border-radius:14px;background:rgba(224,180,90,.12);color:var(--gold);display:grid;place-items:center;font-size:1.6rem}
.feature h3{font-size:1.4rem;margin-bottom:6px;letter-spacing:-.01em}
.feature p{color:var(--muted);max-width:42em}
.fact{text-align:right;min-width:150px}
.fact b{display:block;font-family:var(--display);font-size:2rem;line-height:1.1;color:var(--gold);font-weight:700}
.fact span{font-size:.85rem;color:var(--muted)}
.founder{background:var(--felt)}
.founder-card{display:flex;gap:36px;align-items:center;background:var(--ivory);color:var(--ink);border-radius:20px;padding:40px;box-shadow:0 8px 0 #2c8a68,0 24px 50px rgba(0,0,0,.4)}
.avatar{width:96px;height:96px;border-radius:50%;background:var(--red);color:#fff8ea;display:grid;place-items:center;font-size:2.4rem;flex-shrink:0}
.founder-card h2{color:var(--ink);font-size:clamp(1.4rem,2.6vw,1.9rem)}
.role{color:#5b5442;margin:4px 0 16px}
.quote{font-family:var(--display);font-weight:500;font-size:1.15rem;line-height:1.55;max-width:34em;padding-left:18px;border-left:3px solid var(--red)}
.cta{text-align:center}
.cta p{color:var(--muted);margin:14px auto 32px;max-width:30em}
.cta .actions{justify-content:center}

/* ---------- Danh mục ---------- */
.crumbs{display:flex;flex-wrap:wrap;gap:8px;font-size:.92rem;color:var(--muted);margin-bottom:28px}
.crumbs a{text-decoration:none;color:var(--muted)}
.crumbs a:hover{color:var(--ivory)}
.crumbs span:last-child{color:var(--ivory)}
.page-title{margin-bottom:12px}
.page-lead{color:var(--muted);max-width:36em;margin-bottom:48px}
.card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px}
.cat-card{display:flex;flex-direction:column;gap:18px;text-decoration:none;padding:28px;border-radius:20px;background:rgba(8,42,35,.55);border:1px solid var(--line);transition:transform .25s,border-color .25s,background .25s}
.cat-card:hover{transform:translateY(-4px);border-color:rgba(224,180,90,.55);background:rgba(22,82,63,.55)}
.card-icon{width:64px;height:64px;border-radius:16px;background:rgba(224,180,90,.14);color:var(--gold);display:grid;place-items:center}
.card-icon svg{width:34px;height:34px}
.cat-card h3{font-size:1.45rem;letter-spacing:-.01em}
.cat-card p{color:var(--muted);font-size:.98rem}
.card-meta{margin-top:auto;font-size:.88rem;color:var(--gold);font-weight:600}

/* ---------- Cò quay Nga ---------- */
.game-shell{max-width:880px;margin:0 auto}
.panel{background:rgba(8,42,35,.6);border:1px solid var(--line);border-radius:22px;padding:36px}
.setup{display:grid;gap:22px}
.setup .lead{margin:0}
label{display:grid;gap:8px;font-weight:600;color:var(--ivory);font-size:.95rem}
label small{font-weight:400;color:var(--muted)}
textarea,select,input[type=number]{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:var(--felt);color:var(--text)}
textarea{min-height:120px;resize:vertical;line-height:1.6}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.err{color:#ffb3a8;min-height:1.4em;font-size:.92rem}
.play{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center}
.turn-banner{font-family:var(--display);font-size:1.6rem;color:var(--ivory);margin-bottom:6px}
.turn-banner b{color:var(--gold)}
.cyl-box{position:relative;width:220px;height:220px;margin:18px auto 26px}
.cyl{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 35% 30%,#3d5149,#16241f 70%);border:3px solid var(--gold);box-shadow:inset 0 0 22px rgba(0,0,0,.6),0 12px 30px rgba(0,0,0,.45);transition:transform .55s cubic-bezier(.2,.8,.2,1)}
.ch{position:absolute;left:50%;top:50%;width:38px;height:38px;margin:-19px;border-radius:50%;background:#050d0b;border:2px solid #7a6835;transform:rotate(var(--a)) translateY(-68px);transition:background .3s,opacity .3s}
.ch.spent{opacity:.3}
.ch.fired{background:var(--red);border-color:#ffb3a8;opacity:1}
.cyl-pointer{position:absolute;top:-22px;left:50%;transform:translateX(-50%);border-left:12px solid transparent;border-right:12px solid transparent;border-top:18px solid var(--gold);z-index:2}
.cyl-center{position:absolute;left:50%;top:50%;width:26px;height:26px;margin:-13px;border-radius:50%;background:var(--felt-deep);border:2px solid var(--gold)}
.pull{width:100%;padding:18px;font-size:1.15rem}
.result{min-height:92px;margin-top:20px;border-radius:16px;padding:16px 18px;display:grid;align-content:center;text-align:center;border:1px dashed var(--line);color:var(--muted);transition:background .3s,border-color .3s}
.result b{display:block;font-family:var(--display);font-size:1.5rem;color:var(--ivory)}
.result.click{border-style:solid;border-color:rgba(244,236,216,.3);background:rgba(244,236,216,.05)}
.result.boom{border-style:solid;border-color:var(--red);background:rgba(200,55,45,.18)}
.result.boom b{color:#ffb3a8}
.players{display:grid;gap:10px;margin-bottom:22px}
.pl{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-radius:12px;background:rgba(244,236,216,.04);border:1px solid var(--line)}
.pl.now{border-color:var(--gold);background:rgba(224,180,90,.1)}
.pl.out{opacity:.45;text-decoration:line-through}
.pl .name{font-weight:600}
.pl .meta{font-size:.88rem;color:var(--muted)}
.pot{display:flex;gap:12px;margin-bottom:22px}
.pot div{flex:1;padding:12px 14px;border-radius:12px;background:rgba(224,180,90,.08);border:1px solid rgba(224,180,90,.3);text-align:center}
.pot small{display:block;color:var(--muted);font-size:.82rem}
.pot b{font-family:var(--display);font-size:1.25rem;color:var(--gold)}
.log{margin-top:22px;max-height:200px;overflow:auto;display:grid;gap:8px}
.log div{font-size:.92rem;color:var(--muted);padding:8px 12px;border-radius:10px;background:rgba(0,0,0,.18)}
.log div.hit{color:#ffb3a8}
.summary{text-align:center;display:grid;gap:18px;justify-items:center}
.summary h2{font-size:2rem}
.toolbar{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px;justify-content:center}

/* ---------- Chân trang & nhạc ---------- */
footer{border-top:1px solid var(--line);padding:28px 0;text-align:center;font-size:.88rem;color:var(--muted)}
.music{position:fixed;right:20px;bottom:20px;width:272px;z-index:60;background:rgba(8,42,35,.92);backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:16px;box-shadow:0 14px 40px rgba(0,0,0,.5);color-scheme:dark}
.music-head{display:flex;align-items:center;gap:10px;width:100%;padding:12px 14px;background:none;border:0;color:var(--ivory);font:600 .92rem var(--body);cursor:pointer;text-align:left}
.music-head .i:first-child{color:var(--gold)}
.music-head .chev{margin-left:auto;transition:transform .25s}
.music.closed .chev{transform:rotate(180deg)}
.music-body{padding:0 14px 14px}
.music.closed .music-body{display:none}
.music select{width:100%;padding:8px 10px;margin-bottom:10px;border-radius:9px;border:1px solid var(--line);background:var(--felt);color:var(--ivory);font:.9rem var(--body)}
.music audio{width:100%;height:34px}
.lyrics{min-height:38px;display:flex;align-items:center;justify-content:center;text-align:center;font-family:var(--display);font-size:.9rem;color:var(--gold);margin-top:8px;transition:opacity .25s}

/* Con trỏ chấm tròn */
.cursor-dot{position:fixed;top:0;left:0;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:#fff;mix-blend-mode:difference;pointer-events:none;z-index:9999;opacity:0;transition:width .25s ease,height .25s ease,margin .25s ease,opacity .2s}
.cursor-dot.on{opacity:1}
.cursor-dot.big{width:52px;height:52px;margin:-26px 0 0 -26px}
html.has-cursor,html.has-cursor *{cursor:none!important}

/* Bài rơi nền */
.fall{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.fall-tile{position:absolute;top:-90px;width:var(--s);aspect-ratio:5/7;font-size:calc(var(--s)*.54);border-radius:calc(var(--s)*.14);background:linear-gradient(160deg,#fffaf0,var(--ivory));color:var(--ink);font-family:var(--han);font-weight:700;display:grid;place-items:center;opacity:.4;box-shadow:0 calc(var(--s)*.12) 0 #2c8a68;animation:fall var(--d) linear forwards}
.fall-tile.red{color:var(--red)} .fall-tile.green{color:#1b7a50}
.fall-tile.blank::after{content:"";position:absolute;inset:18%;border:2px solid #2a5ea8;border-radius:2px}
@keyframes fall{from{transform:translate3d(0,0,0) rotate(var(--r0))}to{transform:translate3d(var(--dx),calc(100vh + 140px),0) rotate(var(--r1))}}

/* ---------- Giao diện riêng cho Cò quay Nga ---------- */
body.theme-roulette{
  background:radial-gradient(ellipse 90% 70% at 50% -10%,#4a1414 0%,#1a0a0a 55%,#070303 100%);
  --felt:#2a0f0f; --felt-deep:#0c0404; --felt-light:#4a1414;
  --gold:#c9a24a; --red:#b3261e;
}
body.theme-roulette .topbar{background:rgba(12,4,4,.85);border-bottom-color:rgba(201,162,74,.25)}
body.theme-roulette .panel{background:rgba(20,6,6,.72);border-color:rgba(201,162,74,.25)}
body.theme-roulette .cyl{background:radial-gradient(circle at 35% 30%,#5a4a3a,#1d1210 70%);border-color:var(--gold)}
body.theme-roulette .btn-gold{background:#c9a24a;color:#1a0a0a;box-shadow:0 6px 0 #7a5a22}
body.theme-roulette .btn-red{background:#b3261e;box-shadow:0 6px 0 #5e1009}
body.theme-roulette .pl.now{border-color:var(--gold);background:rgba(201,162,74,.12)}
body.theme-roulette .result.boom{background:rgba(179,38,30,.25)}
.intro{display:grid;gap:22px}
.intro .lead{margin-bottom:0}
.discord-play{display:grid;gap:12px;padding-top:22px;border-top:1px solid var(--line)}
.discord-play h3{color:var(--ivory)}
.cmd{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:12px 14px;border-radius:12px;background:rgba(0,0,0,.3);border:1px solid var(--line)}
.cmd code{font-family:ui-monospace,Consolas,monospace;color:var(--ivory);word-break:break-all}
.intro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.intro-item{padding:18px;border-radius:14px;background:rgba(244,236,216,.04);border:1px solid var(--line)}
.intro-item h3{font-size:1.1rem;margin-bottom:6px;color:var(--gold)}
.intro-item p{font-size:.94rem;color:var(--muted)}
@media (max-width:640px){.intro-grid{grid-template-columns:1fr}}
.rr-hero{text-align:center;margin-bottom:36px}
.rr-hero .sub{font-family:var(--display);font-style:italic;font-size:1.15rem;color:var(--gold);margin-bottom:6px}
.rr-hero h1{font-size:clamp(2.6rem,6vw,4.4rem);margin-bottom:0;color:#f4e6cf}
.bullet-fall{position:absolute;top:-60px;width:calc(var(--s)*.55);height:var(--s);border-radius:calc(var(--s)*.25) calc(var(--s)*.25) calc(var(--s)*.08) calc(var(--s)*.08);background:linear-gradient(90deg,#7a5a22,#f1d68a 45%,#a57f33);box-shadow:0 0 calc(var(--s)*.4) rgba(224,180,90,.25);opacity:.45;animation:fall var(--d) linear forwards}

@media (max-width:860px){
  .hero{padding:64px 0}
  .hero .wrap{grid-template-columns:1fr;gap:48px}
  .feature{grid-template-columns:56px 1fr;gap:18px 20px}
  .fact{grid-column:2;text-align:left}
  .founder-card{flex-direction:column;text-align:left;align-items:flex-start;padding:28px}
  .play{grid-template-columns:1fr}
  .panel{padding:26px}
}
@media (max-width:640px){
  .nav-links a:not(.nav-cta){display:none}
  .topbar .wrap{height:60px}
  .music{width:calc(100% - 24px);right:12px;bottom:12px}
  .row2{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important;scroll-behavior:auto!important}
}
</style>
</head>
