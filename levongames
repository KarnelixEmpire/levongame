    const names = $('#rr-names').value.split('\n').map(s => s.trim()).filter(Boolean);
    const bullets = parseInt($('#rr-bullets').value, 10);
    const bet = parseInt($('#rr-bet').value, 10);
    const err = $('#rr-err');
    const unique = new Set(names.map(n => n.toLowerCase()));
    if (names.length < 2) return err.textContent = 'Cần ít nhất 2 người chơi.';
    if (names.length > RR_MAX_PLAYERS) return err.textContent = `Tối đa ${RR_MAX_PLAYERS} người chơi.`;
    if (unique.size !== names.length) return err.textContent = 'Tên người chơi không được trùng nhau.';
    if (!(bullets >= 1 && bullets <= 5)) return err.textContent = 'Số viên đạn phải từ 1 đến 5.';
    if (!(bet >= 1000 && bet <= 1000000)) return err.textContent = 'Tiền cược phải từ 1.000 đến 1.000.000 VNĐ.';
    names.forEach(n => { if (RR_CHIPS[n] === undefined) RR_CHIPS[n] = RR_START_CHIPS; });
    const poor = names.find(n => RR_CHIPS[n] < bet);
    if (poor) return err.textContent = `${poor} không đủ ${fmt(bet)} VNĐ để cược.`;
    startRR(names, bullets, bet);
  });
}

function startRR(names, bullets, bet) {
  RR = {
    players: names.map(name => ({ name, alive: true })),
    bullets,
    bet,
    turn: 0,
    ptr: 0,
    loaded: new Set(randomChambers(bullets)),
    spent: new Set(),
    last: null,
    log: [],
    finished: false,
    winner: null,
  };
  $('#rr-root').innerHTML = `
    <div class="panel">
      <div class="play">
        <div>
          <div class="turn-banner" id="rr-turn"></div>
          <p class="hint" id="rr-sub"></p>
          <div class="cyl-box">
            <div class="cyl" id="rr-cyl">
              ${Array.from({ length: RR_CHAMBERS }, (_, i) =>
                `<span class="ch" data-i="${i}" style="--a:${i * 60}deg"></span>`).join('')}
              <span class="cyl-center"></span>
            </div>
            <div class="cyl-pointer" aria-hidden="true"></div>
          </div>
          <button class="btn btn-red pull" id="rr-pull">${icon('i-cylinder')}Bấm cò</button>
          <div class="result" id="rr-result" aria-live="polite"></div>
        </div>
        <div>
          <div class="pot">
            <div><small>Tiền thưởng</small><b id="rr-pot"></b></div>
            <div><small>Cược mỗi người</small><b>${fmt(bet)}</b></div>
          </div>
          <h3 style="margin-bottom:12px">Người chơi</h3>
          <div class="players" id="rr-players"></div>
          <h3 style="margin-bottom:6px">Nhật ký</h3>
          <div class="log" id="rr-log"></div>
          <div class="toolbar">
            <button class="btn btn-ghost btn-sm" id="rr-end">${icon('i-trophy')}Kết thúc sớm</button>
            <button class="btn btn-ghost btn-sm" id="rr-new">${icon('i-reset')}Ván mới</button>
          </div>
        </div>
      </div>
    </div>`;

  $('#rr-pull').addEventListener('click', pullRR);
  $('#rr-end').addEventListener('click', () => endRREarly());
  $('#rr-new').addEventListener('click', () => { RR = null; showRRSetup(); });
  paintRR();
}

function randomChambers(n) {
  const all = [...Array(RR_CHAMBERS).keys()];
  for (let i = all.length - 1; i > 0; i--) {
    const j = rand(i + 1);
    [all[i], all[j]] = [all[j], all[i]];
  }
  return all.slice(0, n);
}

function aliveRR() {
  return RR.players.filter(p => p.alive);
}

function advanceTurn() {
  const n = RR.players.length;
  let i = (RR.turn + 1) % n;
  while (!RR.players[i].alive) i = (i + 1) % n;
  RR.turn = i;
}

function paintRR() {
  if (!RR) return;
  const cur = RR.players[RR.turn];
  if (RR.finished) {
    showRRSummary();
    return;
  }
  $('#rr-turn').innerHTML = `Lượt của <b>${escapeHtml(cur.name)}</b>`;
  $('#rr-sub').textContent = `Số viên đạn: ${RR.bullets}/${RR_CHAMBERS}. Bấm cò để xem có trúng hay không.`;
  $('#rr-pot').textContent = fmt(RR.bet * RR.players.length) + ' VNĐ';
  $('#rr-pull').disabled = false;

  $('#rr-players').innerHTML = RR.players.map((p, i) => `
    <div class="pl ${i === RR.turn ? 'now' : ''} ${p.alive ? '' : 'out'}">
      <span class="name">${i === RR.turn ? '▶ ' : ''}${escapeHtml(p.name)}</span>
      <span class="meta">${p.alive ? 'Còn sống' : 'Đã loại'}</span>
    </div>`).join('');

  const res = $('#rr-result');
  if (RR.last) {
    res.className = `result ${RR.last.type}`;
    res.innerHTML = `<b>${escapeHtml(RR.last.title)}</b>${escapeHtml(RR.last.text)}`;
  } else {
    res.className = 'result';
    res.innerHTML = 'Chưa có lượt nào. Bấm cò để bắt đầu.';
  }

  $('#rr-log').innerHTML = RR.log.slice(0, 8).map(l =>
    `<div class="${l.hit ? 'hit' : ''}">${escapeHtml(l.text)}</div>`).join('') || '<div>Nhật ký trống.</div>';
}

function pullRR() {
  if (!RR || RR.finished) return;
  const player = RR.players[RR.turn];
  const hit = RR.loaded.has(RR.ptr);
  const chamber = $(`.ch[data-i="${RR.ptr}"]`);

  RR.rot = (RR.rot || 0) - 360 / RR_CHAMBERS;
  $('#rr-cyl').style.transform = `rotate(${RR.rot}deg)`;
  $('#rr-pull').disabled = true;

  setTimeout(() => {
    if (hit) {
      player.alive = false;
      chamber.classList.add('fired');
      RR.last = { type: 'boom', title: `Bùm! ${player.name} bị loại`, text: 'Ổ đạn được nạp lại cho người tiếp theo.' };
      RR.log.unshift({ hit: true, text: `💥 ${player.name} trúng đạn, bị loại.` });
      RR.loaded = new Set(randomChambers(RR.bullets));
      RR.spent.clear();
      $$('.ch').forEach(c => c.classList.remove('spent', 'fired'));
      const alive = aliveRR();
      if (alive.length === 1) {
        RR.winner = alive[0];
        settleRR();
        RR.finished = true;
      }
    } else {
      chamber.classList.add('spent');
      RR.spent.add(RR.ptr);
      RR.last = { type: 'click', title: 'Cạch! An toàn', text: `${player.name} thoát lần này.` };
      RR.log.unshift({ hit: false, text: `✅ ${player.name}: Cạch, an toàn.` });
    }
    RR.log = RR.log.slice(0, 20);
    RR.ptr = (RR.ptr + 1) % RR_CHAMBERS;
    if (!RR.finished) advanceTurn();
    paintRR();
  }, 600);
}

function settleRR() {
  const n = RR.players.length;
  RR.players.forEach(p => {
    if (RR.winner && p === RR.winner) {
      RR_CHIPS[p.name] += RR.bet * (n - 1);
    } else {
      RR_CHIPS[p.name] -= RR.bet;
    }
  });
}

function endRREarly() {
  if (!RR) return;
  RR.finished = true;
  RR.winner = null; // không ai mất tiền
  showRRSummary();
}

function showRRSummary() {
  const w = RR.winner;
  const title = w ? `🏆 ${escapeHtml(w.name)} thắng` : '🤝 Ván kết thúc sớm';
  const text = w
    ? `Nhận <b>+${fmt(RR.bet * (RR.players.length - 1))} VNĐ</b> từ tiền cược của những người khác.`
    : 'Không ai mất tiền. Tiền cược được hoàn lại.';
  const balances = RR.players.map(p => `
    <div class="pl ${p.alive ? '' : 'out'}">
      <span class="name">${escapeHtml(p.name)}${w && p === w ? ' 🏆' : ''}</span>
      <span class="meta">Số dư: ${fmt(RR_CHIPS[p.name])} VNĐ</span>
    </div>`).join('');
  $('#rr-root').innerHTML = `
    <div class="panel summary">
      <h2>${title}</h2>
      <p class="lead">${text}</p>
      <div class="players" style="width:100%;max-width:440px">${balances}</div>
      <div class="toolbar">
        <button class="btn btn-gold btn-sm" id="rr-again">${icon('i-reset')}Chơi ván mới</button>
        <button class="btn btn-ghost btn-sm" id="rr-setup">${icon('i-cylinder')}Đổi người và cược</button>
      </div>
    </div>`;
  $('#rr-again').addEventListener('click', () => {
    startRR(RR.players.map(p => p.name), RR.bullets, RR.bet);
  });
  $('#rr-setup').addEventListener('click', () => { RR = null; showRRSetup(); });
}

/* =========================================================
   CON TRỎ, BÀI RƠI, NHẠC (dùng chung mọi trang)
   ========================================================= */
window.addEventListener('hashchange', render);
render();

// Con trỏ chấm tròn (chỉ trên máy có chuột)
const cursor = document.createElement('div');
cursor.className = 'cursor-dot';
cursor.id = 'cursor';
document.body.prepend(cursor);
if (window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
  document.documentElement.classList.add('has-cursor');
  document.addEventListener('mousemove', e => {
    cursor.style.transform = `translate(${e.clientX}px,${e.clientY}px)`;
    cursor.classList.add('on');
  });
  document.addEventListener('mouseleave', () => cursor.classList.remove('on'));
  document.addEventListener('mouseover', e => {
    cursor.classList.toggle('big', !!e.target.closest('a,button,select,textarea,audio,input,.tile,.cat-card'));
  });
}

// Bài mạt chược rơi nền
if (!window.matchMedia('(prefers-reduced-motion:reduce)').matches) {
  const fall = document.createElement('div');
  fall.className = 'fall';
  fall.id = 'fall';
  fall.setAttribute('aria-hidden', 'true');
  document.body.prepend(fall);
  const faces = [['東', ''], ['南', ''], ['西', ''], ['北', ''], ['發', 'green'], ['中', 'red'], ['', 'blank']];
  function drop() {
    if (fall.children.length > 14) return;
    const dur = 9 + Math.random() * 7;
    const t = document.createElement('div');
    if (document.body.classList.contains('theme-roulette')) {
      t.className = 'bullet-fall';
      t.style.cssText = `--s:${14 + Math.random() * 10}px;left:${Math.random() * 100}%;--d:${dur}s;` +
        `--dx:${(Math.random() - .5) * 120}px;--r0:${(Math.random() - .5) * 40}deg;--r1:${(Math.random() - .5) * 360}deg`;
    } else {
      const [ch, cls] = faces[rand(faces.length)];
      t.className = 'fall-tile ' + cls;
      t.textContent = ch;
      t.style.cssText = `--s:${22 + Math.random() * 18}px;left:${Math.random() * 100}%;--d:${dur}s;` +
        `--dx:${(Math.random() - .5) * 160}px;--r0:${(Math.random() - .5) * 60}deg;--r1:${(Math.random() - .5) * 540}deg`;
    }
    fall.appendChild(t);
    setTimeout(() => t.remove(), dur * 1000);
  }
  setInterval(drop, 900);
  for (let i = 0; i < 5; i++) setTimeout(drop, i * 300);
}

// Trình phát nhạc
const music = $('#music');
const musicToggle = $('#music-toggle');
function setMusic(open) {
  music.classList.toggle('closed', !open);
  musicToggle.setAttribute('aria-expanded', open);
}
musicToggle.addEventListener('click', () => setMusic(music.classList.contains('closed')));
if (window.innerWidth < 640) setMusic(false);

const songData = {
  'luu-nien': { file: 'luu-nien.mp3', lyrics: [{ t: 0, text: '♪ Lưu Niên ♪' }, { t: 12, text: 'Từng ngày qua ta bên nhau...' }, { t: 18, text: 'Ký ức như một giấc mơ...' }] },
  'nguoi-dung': { file: 'nguoi-dung.mp3', lyrics: [{ t: 0, text: '♪ Người Dưng ♪' }, { t: 15, text: 'Người dưng ơi, có nhớ ta không...' }, { t: 22, text: 'Tình nghĩa phút chốc nhạt phai...' }] },
  'thuong-nhau': { file: 'thuong-nhau.mp3', lyrics: [{ t: 0, text: '♪ Thương Nhau Đến Thế ♪' }, { t: 14, text: 'Yêu nhau đến thế, sao vội chia xa...' }, { t: 20, text: 'Nước mắt rơi ướt nhòa...' }] },
};
const select = $('#song-select');
const player = $('#audio-player');
const source = $('#audio-source');
const lyricsEl = $('#lyrics');
let currentLyrics = songData[select.value].lyrics;

select.addEventListener('change', () => {
  const data = songData[select.value];
  source.src = data.file;
  player.load();
  player.play().catch(() => {});
  currentLyrics = data.lyrics;
  lyricsEl.textContent = 'Đang phát...';
});

player.addEventListener('timeupdate', () => {
  let text = '';
  for (let i = currentLyrics.length - 1; i >= 0; i--) {
    if (player.currentTime >= currentLyrics[i].t) { text = currentLyrics[i].text; break; }
  }
  if (text && lyricsEl.textContent !== text) {
    lyricsEl.style.opacity = 0;
    setTimeout(() => { lyricsEl.textContent = text; lyricsEl.style.opacity = 1; }, 200);
  }
});
</script>
