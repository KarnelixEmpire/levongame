   ========================================================= */
function parseRoute() {
  return location.hash.replace(/^#\/?/, '').split('/').filter(Boolean);
}

function setActiveNav(name) {
  $$('.nav-links a[data-nav]').forEach(a => a.classList.toggle('active', a.dataset.nav === name));
}

function render() {
  const [a, b] = parseRoute();
  const app = $('#app');
  window.scrollTo({ top: 0, behavior: 'instant' });
  const roulette = a === 'tro-choi' && b === 'co-quay-nga';
  document.body.classList.toggle('theme-roulette', roulette);
  const fallEl = $('#fall');
  if (fallEl) fallEl.innerHTML = '';

  if (!a) {
    setActiveNav('home');
    app.innerHTML = viewHome();
    bindHome();
    document.title = 'Levon Games';
  } else if (a === 'danh-muc' && !b) {
    setActiveNav('danh-muc');
    app.innerHTML = viewCategories();
    document.title = 'Categories • Levon Games';
  } else if (a === 'danh-muc' && b) {
    const cat = CATEGORIES.find(x => x.id === b);
    setActiveNav('danh-muc');
    if (cat) {
      app.innerHTML = viewCategory(cat);
      document.title = `${cat.name} • Levon Games`;
    } else {
      app.innerHTML = viewNotFound();
      document.title = 'Không tìm thấy • Levon Games';
    }
  } else if (a === 'tro-choi' && b === 'co-quay-nga') {
    setActiveNav('danh-muc');
    app.innerHTML = viewRoulettePage();
    RR = null;
    showRRIntro();
    document.title = 'Cò quay Nga • Levon Games';
  } else {
    setActiveNav('');
    app.innerHTML = viewNotFound();
    document.title = 'Không tìm thấy • Levon Games';
  }
}

