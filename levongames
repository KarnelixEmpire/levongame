function bindHome() {
  const hand = $('#hand');
  const river = $('#river');
  const tiles = () => $$('.tile', hand);
  $$('.tile').forEach(t => t.style.setProperty('--r', t.dataset.r || '0deg'));
  $$('.tile').forEach(t => {
    t.addEventListener('click', () => {
      if (t.parentElement === hand) {
        river.appendChild(t);
      } else {
        const order = tiles();
        const idx = order.indexOf(t);
        // trả quân về đúng vị trí ban đầu trong tay
        const after = $$('.tile', hand).find(c => order.indexOf(c) > idx);
        hand.insertBefore(t, after || null);
      }
    });
  });
}

